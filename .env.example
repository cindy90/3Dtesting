# Copy to .env and fill in. Never commit real keys.
# Load with:  set -a && source .env && set +a

# Tripo 3.x — https://platform.tripo3d.ai (API keys)
TRIPO_API_KEY=

# Meshy 6 — https://www.meshy.ai (Settings -> API)
MESHY_API_KEY=

# Rodin Gen-2 (影眸/Deemos) — https://hyperhuman.deemos.com (Developer / API)
RODIN_API_KEY=

# Seed3D (字节跳动) — 火山引擎方舟控制台 -> API Key 管理;需先在开通管理里
# 开通 doubao-seed3d 模型 (https://console.volcengine.com/ark)
ARK_API_KEY=

# fal.ai — hosts Hunyuan3D and TRELLIS (https://fal.ai/dashboard/keys)
FAL_KEY=
